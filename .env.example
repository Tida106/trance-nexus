# Copy this file to `.env.local` and fill in the values you actually use.
# `.env.local` is gitignored — never commit real keys.

# --- Public site config ---
NEXT_PUBLIC_API_URL=http://localhost:3000

# Google Analytics 4 — set your Measurement ID (G-XXXXXXXXXX).
# Leave blank to disable GA4 (cookie banner will not load it).
NEXT_PUBLIC_GA_ID=

# --- Newsletter signup form ---
# See docs/newsletter.md for the full setup walkthrough.
# Buttondown:  https://buttondown.com/api/emails/embed-subscribe/<USERNAME>
# Mailchimp:   https://<DC>.list-manage.com/subscribe/post?u=<U>&id=<ID>
# Leave both blank to render the form in "configuration pending" mode.
NEXT_PUBLIC_NEWSLETTER_PROVIDER=
NEXT_PUBLIC_NEWSLETTER_ENDPOINT=

# Apple Music affiliate token (Performance Partners / Impact).
# Auto-appended as `?at=` on Apple Music embeds when set.
NEXT_PUBLIC_APPLE_AFFILIATE=

# --- Affiliate networks ---
# Beatport (Impact). Get IDs from https://app.impact.com — Beatport program.
NEXT_PUBLIC_BEATPORT_CAMPAIGN_ID=
NEXT_PUBLIC_BEATPORT_PUBLISHER_ID=

# Resident Advisor (Awin). Get ID from https://www.awin.com.
NEXT_PUBLIC_RA_AWIN_ID=

# Amazon.co.jp Associates Store ID. Used by components/AmazonLink.jsx to
# build /dp/<ASIN>?tag=<id> URLs. The component falls back to the
# production tag if unset.
NEXT_PUBLIC_AMAZON_ASSOCIATE_ID=sacredjapan-22

# --- Search / indexing ---
# IndexNow auto-submission key. Generate with `openssl rand -hex 16`.
# Also add to GitHub repo secrets as INDEXNOW_KEY.
INDEXNOW_KEY=

# --- Scrapers ---
SCRAPER_DELAY=1000
MAX_RETRIES=3

# --- X (Twitter) automation ---
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
